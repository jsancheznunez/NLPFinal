{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlpfinal.local/schemas/aspects.schema.json",
  "title": "aspects.json: category aspect leaderboard",
  "description": "Aspects and opinions are extracted by spaCy (noun chunks + dependency rules); each pair is scored by NLTK VADER.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "method",
    "n_pairs",
    "items"
  ],
  "properties": {
    "source": {
      "const": "spacy+nltk"
    },
    "method": {
      "type": "string"
    },
    "n_pairs": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "nltk_analysis.schema.json#/$defs/aspect"
          }
        ],
        "required": [
          "n_products"
        ]
      }
    }
  }
}

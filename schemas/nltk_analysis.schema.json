{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlpfinal.local/schemas/nltk_analysis.schema.json",
  "title": "NLTK analysis of one text",
  "description": "Output of analyzer.nltk_layer.analyze(text). Produced by NLTK only, identically at build time (CPython 3.12) and in the browser (Pyodide 314.0.8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "nltk_version",
    "n_chars",
    "n_tokens",
    "tokens",
    "sentiment",
    "sentences",
    "top_words",
    "key_phrases"
  ],
  "properties": {
    "source": {
      "const": "nltk"
    },
    "nltk_version": {
      "type": "string"
    },
    "n_chars": {
      "type": "integer",
      "minimum": 0
    },
    "n_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 300
    },
    "sentiment": {
      "$ref": "#/$defs/vader"
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "compound",
          "label"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "compound": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "top_words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "key_phrases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure",
        "min_freq",
        "items"
      ],
      "properties": {
        "measure": {
          "const": "likelihood_ratio"
        },
        "min_freq": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "enum": [
        "positive",
        "neutral",
        "negative"
      ]
    },
    "vader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compound",
        "pos",
        "neu",
        "neg",
        "label"
      ],
      "properties": {
        "compound": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neu": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neg": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "count",
        "freq"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "freq": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phrase",
        "count",
        "score"
      ],
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number"
        }
      }
    },
    "sentiment_mix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "neutral",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neutral": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "negative": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "term_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        }
      }
    },
    "collocation_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure",
        "min_freq",
        "positive",
        "negative"
      ],
      "properties": {
        "measure": {
          "const": "likelihood_ratio"
        },
        "min_freq": {
          "type": "integer",
          "minimum": 1
        },
        "positive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      }
    },
    "count_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "count"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entity_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "label",
        "count"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect",
        "mentions",
        "mean_compound",
        "pct_negative",
        "top_opinions"
      ],
      "properties": {
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "mentions": {
          "type": "integer",
          "minimum": 1
        },
        "n_products": {
          "type": "integer",
          "minimum": 1
        },
        "mean_compound": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pct_negative": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_opinions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count_item"
          }
        }
      }
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "review_example": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "text",
        "rating",
        "compound",
        "helpful_vote",
        "date"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "compound": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "helpful_vote": {
          "type": "integer",
          "minimum": 0
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
